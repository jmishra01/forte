{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "forte",
  "version": "0.2.0",
  "identifier": "com.jitendra.forte",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1430",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Forte",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' notefile: http://notefile.localhost data: blob: https:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "worker-src": "blob:",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' notefile: http://notefile.localhost data: blob: https:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost ws://localhost:1430",
        "worker-src": "blob:",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "license": "MIT",
    "copyright": "Copyright (c) 2026 Jitendra Mishra",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
